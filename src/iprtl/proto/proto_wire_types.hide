#pragma once
#include <cstdint>
#include <variant>
#include <vector>


#include "enums.h"

namespace iprtl::proto::wire {

/*
0	VARINT	int32, int64, uint32, uint64, sint32, sint64, bool, enum
1	I64	fixed64, sfixed64, double
2	LEN	string, bytes, embedded messages, packed repeated fields
3	SGROUP	group start (deprecated)
4	EGROUP	group end (deprecated)
5	I32	fixed32, sfixed32, float
*/
ENUMS(type_id, uint8_t,
    VARINT = 0,
    I64    = 1,
    LEN    = 2,
    SGROUP = 3,
    EGROUP = 4,
    I32    = 5
)

enum class varint : uint64_t {};
enum class i32 : uint32_t {};
enum class i64 : uint64_t {};
using len_data = std::vector<uint8_t>;


template<typename ValueType>
struct record_t{
    uint32_t field_number;
    ValueType value;
};

using VarintRecord = record_t<varint>;
using I32Record = record_t<i32>;
using I64Record = record_t<i64>;
using LenDataRecord = record_t<len_data>;

using RecordVariant = std::variant<VarintRecord, I32Record, I64Record, LenDataRecord>;

struct record {
    uint32_t field_number;
    std::variant<varint, i32, i64, len_data> value;
    auto operator<=>(const record& rhs) const {
    if (field_number != rhs.field_number) {
        return field_number <=> rhs.field_number;
    }
    return value <=> rhs.value;
   }
   bool operator==(const record& rhs) const {
       return (field_number == rhs.field_number) && (value == rhs.value);
   }
};

} // namespace iprtl::proto::wire

